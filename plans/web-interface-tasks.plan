  ```sql
  CREATE TABLE de_identification_state (
      job_id TEXT PRIMARY KEY,
      first_pass_complete BOOLEAN DEFAULT FALSE,
      second_pass_complete BOOLEAN DEFAULT FALSE,
      discovered_names_json TEXT,
